{
  "name": "neogestify-ui-components",
  "version": "3.10.3",
  "description": "Biblioteca de componentes UI reutilizables con React, Tailwind y SweetAlert: formularios, tarjetas, calendario, editor de mapas (VenueMapEditor) y colores configurables",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./html": {
      "types": "./dist/components/html/index.d.ts",
      "import": "./dist/components/html/index.mjs",
      "require": "./dist/components/html/index.js"
    },
    "./icons": {
      "types": "./dist/components/icons/index.d.ts",
      "import": "./dist/components/icons/index.mjs",
      "require": "./dist/components/icons/index.js"
    },
    "./alerts": {
      "types": "./dist/components/alerts/index.d.ts",
      "import": "./dist/components/alerts/index.mjs",
      "require": "./dist/components/alerts/index.js"
    },
    "./theme": {
      "types": "./dist/context/theme/index.d.ts",
      "import": "./dist/context/theme/index.mjs",
      "require": "./dist/context/theme/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.mjs",
      "require": "./dist/hooks/index.js"
    },
    "./config": {
      "types": "./dist/context/config/index.d.ts",
      "import": "./dist/context/config/index.mjs",
      "require": "./dist/context/config/index.js"
    },
    "./venue-map": {
      "types": "./dist/components/VenueMapEditor/index.d.ts",
      "import": "./dist/components/VenueMapEditor/index.mjs",
      "require": "./dist/components/VenueMapEditor/index.js"
    },
    "./tokens": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.mjs",
      "require": "./dist/theme/index.js"
    },
    "./calendar": {
      "types": "./dist/components/Calendar/index.d.ts",
      "import": "./dist/components/Calendar/index.mjs",
      "require": "./dist/components/Calendar/index.js"
    },
    "./element-library-builder": {
      "types": "./dist/components/ElementLibraryBuilder/index.d.ts",
      "import": "./dist/components/ElementLibraryBuilder/index.mjs",
      "require": "./dist/components/ElementLibraryBuilder/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsup && node scripts/use-client.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwind",
    "sweetalert"
  ],
  "author": "luis3132",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "sweetalert2": "^11.0.0",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "sweetalert2": {
      "optional": true
    }
  },
  "dependencies": {
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sweetalert2": "^11.26.24",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
