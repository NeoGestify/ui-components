{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* La librería se resuelve contra su código fuente, igual que en el alias
       de Vite. Sin esto TypeScript buscaría el paquete en node_modules, donde
       ya no está instalado. */
    "baseUrl": ".",
    "paths": {
      "neogestify-ui-components": ["../src/index.ts"]
    }
  },
  "include": ["src", "../src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
